# Copy to apps/admin/.env after preparing a locally trusted certificate. Node-only values.
ADMIN_DEV_API_ORIGIN=http://127.0.0.1:3100
ADMIN_DEV_AUTH_CHECK=true
ADMIN_DEV_TLS_CERT=/absolute/local/path/certificates/admin-local.pem
ADMIN_DEV_TLS_KEY=/absolute/local/path/certificates/admin-local-key.pem
