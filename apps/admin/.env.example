# Node-only Vite development proxy setting. Never use a public environment prefix.
ADMIN_DEV_API_ORIGIN=http://127.0.0.1:3100

# Opt in with .env.https.example for the HTTPS-only development auth harness.
ADMIN_DEV_AUTH_CHECK=false
# Certificate/key are Node-only absolute paths, required only for true; keep key private (chmod 600).
# ADMIN_DEV_TLS_CERT=/absolute/local/path/certificates/admin-local.pem
# ADMIN_DEV_TLS_KEY=/absolute/local/path/certificates/admin-local-key.pem
