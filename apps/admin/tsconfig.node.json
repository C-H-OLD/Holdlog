{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "test/**/*",
    "node-checks/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
