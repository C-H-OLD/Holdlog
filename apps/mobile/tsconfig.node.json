{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app.config.ts",
    "configuration/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "ios",
    "android"
  ]
}
