{
  "extends": [
    "expo/tsconfig.base",
    "../../tsconfig.base.json"
  ],
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "types": [
      "react",
      "react-native"
    ],
    "lib": [
      "ES2022"
    ],
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "checks/**/*",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "generated",
    "ios",
    "android"
  ]
}
