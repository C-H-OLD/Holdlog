NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3100
DATABASE_URL=postgresql://holdlog:replace-with-development-secret@127.0.0.1:55432/holdlog_dev
# Development host-only directory. Compose also reserves a private-files volume.
PRIVATE_STORAGE_PATH=/absolute/local/path/holdlog-private-files
ALLOWED_ORIGINS=http://localhost:5173
WORKER_QUEUE=foundation-check

# Set true only after supplying the provider settings below.
MOBILE_IDENTITY_ENABLED=false
# Administrator endpoints can be enabled without any mobile provider settings.
ADMIN_IDENTITY_ENABLED=false

# Required only for MOBILE_IDENTITY_ENABLED=true; health/worker and admin-only mode do not load these.
# CSV allowlists contain the exact native Google client IDs and Apple bundle/Services IDs.
# Provider JWKS/issuers are fixed in server code, not configurable via a token or URL setting.
GOOGLE_CLIENT_IDS=replace-with-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.holdlog.development,replace-with-apple-services-id
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
# Absolute path to an ignored Apple P-256 .p8 key; never copy PEM material into this file.
APPLE_PRIVATE_KEY_PATH=/absolute/local/path/secrets/apple-sign-in.p8
# Required only for ADMIN_IDENTITY_ENABLED=true.
# Independently generated 32 random bytes encoded in canonical base64; not a password/token.
ADMIN_CSRF_KEY=replace-with-random-base64-secret
ADMIN_ALLOWED_ORIGINS=https://localhost:5173
