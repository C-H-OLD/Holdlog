{
  "name": "@holdlog/server",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "dev:api": "npm run build && node --env-file=.env dist/src/main.js",
    "dev:worker": "npm run build && node --env-file=.env dist/src/worker.js",
    "db:migrate": "npm run build && node --env-file=.env dist/src/database/cli.js",
    "test": "npm run build && node --test dist/test/config.spec.js",
    "test:foundation": "npm run build && node --test --test-concurrency=1 dist/test/*.spec.js dist/test/*e2e-spec.js"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "type": "module"
}
