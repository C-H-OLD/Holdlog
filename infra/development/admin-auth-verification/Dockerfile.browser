# Isolated Linux browser trust store; host trust stores are never modified.
FROM node:24.21.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium libnss3-tools ca-certificates fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
RUN npm install --prefix /opt/holdlog-browser --no-audit --no-fund playwright-core@1.62.1
